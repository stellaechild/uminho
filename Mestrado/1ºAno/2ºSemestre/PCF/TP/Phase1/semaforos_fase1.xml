			<result outcome="success" type="quality" timestamp="2024-03-25 16:29:35 +0000">
			</result>
		</query>
		<query>
			<formula>Sensor.Inactive and y&gt;30 --&gt; SemPrinc.VerdePrinc</formula>
			<comment>(additional) no cars picked up by sensor on the minor road and the clock has exceeded 30 seconds will eventually lead to the major road light to go green</comment>
			<result outcome="success" type="quality" timestamp="2024-03-25 16:26:10 +0000">
			</result>
		</query>
		<query>
			<formula>E&lt;&gt; not(SemSec.Vermelho and SemPrinc.VermelhoPrinc and Sensor.Active)</formula>
