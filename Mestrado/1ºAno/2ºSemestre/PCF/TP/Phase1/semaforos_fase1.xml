	<queries>
		<query>
			<formula>E&lt;&gt; SemSec.Verde</formula>
			<comment>(1) the minor-road light can go green</comment>
			<result outcome="success" type="quality" timestamp="2024-03-25 16:10:47 +0000">
			</result>
		</query>
		<query>
			<formula>E&lt;&gt; SemPrinc.VermelhoPrinc</formula>
