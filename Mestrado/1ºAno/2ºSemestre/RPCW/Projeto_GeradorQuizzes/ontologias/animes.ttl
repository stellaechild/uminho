#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/rodrigop/ontologies/2021/3/animes#hasGenre
:hasGenre rdf:type owl:ObjectProperty ;
          owl:inverseOf :isGenre ;
          rdfs:domain :Anime ;
          rdfs:range :Genre .


###  http://www.semanticweb.org/rodrigop/ontologies/2021/3/animes#hasLicense
:hasLicense rdf:type owl:ObjectProperty ;
            owl:inverseOf :isLicense ;
            rdfs:domain :Anime ;
            rdfs:range :License .


###  http://www.semanticweb.org/rodrigop/ontologies/2021/3/animes#hasProducer
:hasProducer rdf:type owl:ObjectProperty ;
             rdfs:domain :Anime ;
             rdfs:range :Producer .


###  http://www.semanticweb.org/rodrigop/ontologies/2021/3/animes#hasStudio
:hasStudio rdf:type owl:ObjectProperty ;
           owl:inverseOf :isStudio ;
           rdfs:domain :Anime ;
           rdfs:range :Studio .


###  http://www.semanticweb.org/rodrigop/ontologies/2021/3/animes#hasTheme
:hasTheme rdf:type owl:ObjectProperty ;
          owl:inverseOf :isTheme ;
          rdfs:domain :Anime ;
          rdfs:range :Theme_Music .


###  http://www.semanticweb.org/rodrigop/ontologies/2021/3/animes#isGenre
:isGenre rdf:type owl:ObjectProperty .


###  http://www.semanticweb.org/rodrigop/ontologies/2021/3/animes#isLicense
:isLicense rdf:type owl:ObjectProperty .


###  http://www.semanticweb.org/rodrigop/ontologies/2021/3/animes#isProducer
:isProducer rdf:type owl:ObjectProperty ;
            owl:inverseOf :isProducer .



###  http://www.semanticweb.org/rodrigop/ontologies/2021/3/animes#isStudio
:isStudio rdf:type owl:ObjectProperty .


###  http://www.semanticweb.org/rodrigop/ontologies/2021/3/animes#isTheme
