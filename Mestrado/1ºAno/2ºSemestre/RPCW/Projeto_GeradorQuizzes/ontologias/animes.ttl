###  http://www.semanticweb.org/rodrigop/ontologies/2021/33/animes#anime_16662
:anime_16662 rdf:type owl:NamedIndividual ,
				:Anime ;
			:hasGenre :genre_9 ;
			:hasGenre :genre_27 ;
			:hasGenre :genre_3 ;
