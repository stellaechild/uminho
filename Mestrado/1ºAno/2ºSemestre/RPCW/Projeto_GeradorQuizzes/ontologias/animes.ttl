			:hasLicense :licensor_7 ;
			:hasProducer :producer_677 ;
			:hasStudio :studio_155 ;
			:hasTheme :Theme_7752 ;
			:aired "Jan 1, 1963 to Dec 31, 1966" ;
			:type "TV" ;
			:title_synonyms "Mighty Atom" ;
			:title_japanese "鉄腕アトム" ;
			:title_english "Astro Boy" ;
			:status "Finished Airing" ;
			:source "Manga" ;
			:scored_by 1785 ;
			:score "7.25" ;
			:rating "PG - Children" ;
			:rank "2633.0" ;
			:premiered "Winter 1963" ;
			:popularity 4322 ;
			:image_url "https://myanimelist.cdn-dena.com/images/anime/10/79582.jpg" ;
			:favorites 25 ;
			:episodes 193;
			:duration "26 min. per ep." ;
			:broadcast "Saturdays at 19:00 (JST)" ;
			:background "Tetsuwan Atom was the first television anime series to air in a 30-minute programming slot. It was broadcast by Fuji Television and aired on Tuesdays when broadcast began in 1963. The first episode debuted on New Year&#039;s Day with a 27.4% viewership rating, with the series later peaking at over 40% rating by the following year. From 1964 onward, the airing was changed to Saturdays.When American television producer Fred Ladd helped NBC Enterprises adapt the series for broadcast in the United States in 1963, the title Astro Boy was used instead of the manga&#039;s English title Mighty Atom. The change was forced because of its similarity to the contemporary American superhero character Mighty Mouse, which Osamu Tezuka used as a basis for the character Atom." ;
			:interested_num "6715" ;
		:title "Tetsuwan Atom" .

